<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Cabecera de la tarjeta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Miniatura superior izquierda -->
        <ImageView
            android:id="@+id/ivCardThumbnail"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:background="#E0ECEE"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="#005F6B"
            android:contentDescription="Miniatura de la tarjeta" />

        <!-- Bloque de Título y Subtítulo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Encabezado o título"
                android:textColor="#1F2937"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Subtítulo"
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Botón menú de tres puntos -->
        <ImageButton
            android:id="@+id/btnCardMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#005F6B"
            android:contentDescription="Más opciones de la tarjeta" />
    </LinearLayout>

    <!-- Imagen principal central -->
    <ImageView
        android:id="@+id/ivCardMedia"
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:background="#E0ECEE"
        android:scaleType="center"
        android:src="@android:drawable/ic_menu_gallery"
        app:tint="#005F6B"
        android:contentDescription="Imagen principal de la tarjeta" />

    <!-- Cuerpo y botones de acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvCardDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Esta es una breve descripción sobre la Card."
            android:textColor="#374151"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Botón primario sólido -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCardPrimary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Acción"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="#005F6B"
                app:cornerRadius="20dp" />

            <!-- Botón secundario con borde -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCardSecondary"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Acción"
                android:textAllCaps="false"
                android:textColor="#005F6B"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="#005F6B"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>